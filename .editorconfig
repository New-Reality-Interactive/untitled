root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# google-java-format (Google style), enforced by Spotless
[*.java]
indent_size = 2
max_line_length = 100

[*.xml]
indent_size = 4

[{*.yaml,*.yml,*.json}]
indent_size = 2

[*.cmd]
end_of_line = crlf
