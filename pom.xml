<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.newrealityinteractive</groupId>
    <artifactId>untitled</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>untitled</name>
    <description>Reactive Spring Boot service</description>

    <properties>
        <java.version>25</java.version>
        <maven.minimum.version>3.9</maven.minimum.version>
        <!-- Netty loads native transports; JDK 25 warns about restricted methods without this. -->
        <native.access.arg>--enable-native-access=ALL-UNNAMED</native.access.arg>
        <!-- -DskipTests or -DskipITs also skips starting the app, spec generation, drift and coverage checks. -->
        <skipTests>false</skipTests>
        <skipITs>${skipTests}</skipITs>
        <!-- ./mvnw spring-boot:run uses the developer profile (config/application-local.yaml); -Dspring-boot.run.profiles= turns it off. -->
        <spring-boot.run.profiles>local</spring-boot.run.profiles>

        <!-- Libraries not managed by Spring Boot -->
        <springdoc.version>3.1.1</springdoc.version>

        <!-- Build plugins: pinned to latest releases, overriding older Boot-managed versions -->
        <build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>
        <git-commit-id-maven-plugin.version>10.0.1</git-commit-id-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <spotless-maven-plugin.version>3.10.3</spotless-maven-plugin.version>
        <springdoc-openapi-maven-plugin.version>1.5</springdoc-openapi-maven-plugin.version>
        <versions-maven-plugin.version>2.22.0</versions-maven-plugin.version>

        <!-- Coverage -->
        <jacoco.coverage.minimum>0.80</jacoco.coverage.minimum>
        <jacoco.unit.file>${project.build.directory}/jacoco.exec</jacoco.unit.file>
        <jacoco.it.file>${project.build.directory}/jacoco-it.exec</jacoco.it.file>
        <jacoco.merged.file>${project.build.directory}/jacoco-merged.exec</jacoco.merged.file>

        <!-- OpenAPI spec: generated during integration-test, compared against the committed copy -->
        <openapi.generated.dir>${project.build.directory}/openapi</openapi.generated.dir>
        <openapi.committed.file>${project.basedir}/docs/openapi.json</openapi.committed.file>

        <!-- Formatting: the formatter version is plugin configuration, so versions:display-plugin-updates does not report it -->
        <google-java-format.version>1.36.1</google-java-format.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>${maven.minimum.version}</version>
                                </requireMavenVersion>
                                <requireReleaseDeps>
                                    <message>SNAPSHOT dependencies are not allowed.</message>
                                    <failWhenParentIsSnapshot>true</failWhenParentIsSnapshot>
                                </requireReleaseDeps>
                                <requirePluginVersions>
                                    <banSnapshots>true</banSnapshots>
                                </requirePluginVersions>
                                <!--
                                  swagger-core (via springdoc) asks for a newer Jackson 2 than Boot manages.
                                  Version policy keeps libraries on Boot-managed versions, so only Jackson 2
                                  is exempt; the integration tests exercise swagger-core on it.
                                -->
                                <requireUpperBoundDeps>
                                    <excludes>
                                        <exclude>com.fasterxml.jackson.core:jackson-annotations</exclude>
                                        <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                                        <exclude>com.fasterxml.jackson.dataformat:jackson-dataformat-yaml</exclude>
                                        <exclude>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</exclude>
                                    </excludes>
                                </requireUpperBoundDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Reserve free ports so the build never depends on 8080/8081 (or JMX 9001) being free. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>reserve-ports</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>reserve-network-port</goal>
                        </goals>
                        <configuration>
                            <portNames>
                                <portName>it.app.port</portName>
                                <portName>it.management.port</portName>
                                <portName>it.jmx.port</portName>
                            </portNames>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Exposes org.mockito:mockito-core:jar as a property for the -javaagent below. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dependency-properties</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              JDK 23+ no longer discovers annotation processors on the classpath; declare it explicitly.
              It is deliberately not a <dependency>: that would list it in the SBOM although the jar does not ship it.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} "-javaagent:${org.mockito:mockito-core:jar}" ${native.access.arg}</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} "-javaagent:${org.mockito:mockito-core:jar}" ${native.access.arg}</argLine>
                    <systemPropertyVariables>
                        <it.app.port>${it.app.port}</it.app.port>
                        <it.management.port>${it.management.port}</it.management.port>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <configuration>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                </configuration>
            </plugin>

            <!--
              The Boot parent configures the execution: a CycloneDX JSON SBOM of the non-test dependencies,
              written at generate-resources to META-INF/sbom/application.cdx.json and served by /actuator/sbom.
            -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>start-app</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>start</goal>
                        </goals>
                        <configuration>
                            <skip>${skipITs}</skip>
                            <jmxPort>${it.jmx.port}</jmxPort>
                            <jvmArguments>${jacoco.it.agent} ${native.access.arg}</jvmArguments>
                            <!-- Scalar form on purpose: with <profile> child elements Maven also evaluates ${spring-boot.run.profiles} (local) and it wins. -->
                            <profiles>it</profiles>
                            <arguments>
                                <argument>--server.port=${it.app.port}</argument>
                                <argument>--management.server.port=${it.management.port}</argument>
                                <argument>--spring.config.additional-location=optional:file:${project.build.testOutputDirectory}/</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stop-app</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>stop</goal>
                        </goals>
                        <configuration>
                            <skip>${skipITs}</skip>
                            <jmxPort>${it.jmx.port}</jmxPort>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-maven-plugin</artifactId>
                <version>${springdoc-openapi-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>generate-openapi</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>${skipITs}</skip>
                    <apiDocsUrl>http://localhost:${it.app.port}/v3/api-docs</apiDocsUrl>
                    <outputDir>${openapi.generated.dir}</outputDir>
                    <outputFileName>openapi.json</outputFileName>
                </configuration>
            </plugin>

            <!--
              Declared after spring-boot-maven-plugin so, within post-integration-test, the app stops
              (flushing IT coverage) before merge, report and check run.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <configuration>
                    <excludes>
                        <exclude>com/newrealityinteractive/untitled/Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <destFile>${jacoco.unit.file}</destFile>
                        </configuration>
                    </execution>
                    <!-- Bound to package so the agent property exists before spring-boot:start. -->
                    <execution>
                        <id>prepare-agent-integration</id>
                        <phase>package</phase>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <destFile>${jacoco.it.file}</destFile>
                            <propertyName>jacoco.it.agent</propertyName>
                        </configuration>
                    </execution>

                    <execution>
                        <id>merge</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <skip>${skipITs}</skip>
                            <destFile>${jacoco.merged.file}</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <skip>${skipITs}</skip>
                            <dataFile>${jacoco.merged.file}</dataFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${skipITs}</skip>
                            <dataFile>${jacoco.merged.file}</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.coverage.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Fails the build when the generated OpenAPI spec differs from docs/openapi.json. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>openapi-drift-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skipITs}</skip>
                            <target>
                                <fail message="docs/openapi.json is out of date. Run ./mvnw verify, then copy target/openapi/openapi.json to docs/openapi.json.">
                                    <condition>
                                        <not>
                                            <filesmatch file1="${openapi.generated.dir}/openapi.json"
                                                        file2="${openapi.committed.file}"
                                                        textfile="true"/>
                                        </not>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Fails verify when a file is not formatted; fix with ./mvnw spotless:apply.
              Not tied to skipTests/skipITs: formatting does not depend on tests.
              docs/openapi.json is excluded because it is generated and compared byte for byte.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                    </java>
                    <formats>
                        <format>
                            <includes>
                                <include>pom.xml</include>
                                <include>src/**/*.yaml</include>
                                <include>src/**/*.yml</include>
                                <include>config/**/*.yaml</include>
                                <include>config/**/*.yml</include>
                                <include>*.md</include>
                                <include>.editorconfig</include>
                                <include>.gitattributes</include>
                                <include>.gitignore</include>
                                <include>.mvn/**/*.properties</include>
                            </includes>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                            <indent>
                                <spaces>true</spaces>
                                <spacesPerTab>4</spacesPerTab>
                            </indent>
                        </format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Not used by this build, but pinned so default lifecycle bindings never pick a version. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>${maven-site-plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <configuration>
                    <ruleSet>
                        <ignoreVersions>
                            <ignoreVersion>
                                <type>regex</type>
                                <version>(?i).*[-.](M|RC|alpha|beta|CR|preview)[-.]?\d*.*</version>
                            </ignoreVersion>
                        </ignoreVersions>
                    </ruleSet>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
