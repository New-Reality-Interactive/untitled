{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "untitled API",
    "description" : "Reactive Spring Boot service",
    "version" : "0.1.0-SNAPSHOT"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "basicAuth" : [ ]
  } ],
  "tags" : [ {
    "name" : "Greetings",
    "description" : "Sample endpoint"
  } ],
  "paths" : {
    "/api/v1/greetings" : {
      "get" : {
        "tags" : [ "Greetings" ],
        "summary" : "Greet someone by name",
        "operationId" : "greet",
        "parameters" : [ {
          "name" : "name",
          "in" : "query",
          "description" : "Name to greet",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 1
          },
          "example" : "Ada"
        } ],
        "responses" : {
          "200" : {
            "description" : "The greeting",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Greeting"
                }
              }
            }
          },
          "400" : {
            "description" : "The name is missing, blank or too long",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid credentials"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ValidationProblem" : {
        "type" : "object",
        "description" : "RFC 9457 problem detail for a request that failed validation",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri",
            "example" : "about:blank"
          },
          "title" : {
            "type" : "string",
            "example" : "Bad Request"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 400
          },
          "detail" : {
            "type" : "string",
            "example" : "Request validation failed"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri",
            "example" : "/api/v1/greetings"
          },
          "errors" : {
            "type" : "array",
            "description" : "One entry per violated constraint, as \"parameter: message\"; absent when the request is rejected before validation (for example, a missing parameter)",
            "example" : [ "name: must not be blank" ],
            "items" : {
              "type" : "string"
            }
          }
        },
        "required" : [ "status", "title" ]
      },
      "Greeting" : {
        "type" : "object",
        "description" : "A greeting addressed to a single name",
        "properties" : {
          "message" : {
            "type" : "string",
            "description" : "The greeting text",
            "example" : "Hello, Ada!"
          }
        },
        "required" : [ "message" ]
      }
    },
    "securitySchemes" : {
      "basicAuth" : {
        "type" : "http",
        "scheme" : "basic"
      }
    }
  }
}